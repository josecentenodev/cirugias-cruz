# Server-only. Never prefix with NEXT_PUBLIC_ — see next.config.ts.
# Local dev: point at a locally-running `pnpm --filter @cirugias-cruz/http run start` (default port 3000).
# Production (Railway): the private-network DNS name of the `http` service,
# e.g. http://${{http.RAILWAY_PRIVATE_DOMAIN}} — set as a real Railway service variable, not here.
API_BASE_URL=http://localhost:3000
