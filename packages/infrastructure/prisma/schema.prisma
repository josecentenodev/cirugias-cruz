// Prisma schema for Milestone 2 — real persistence for the core loop.
//
// Scope is intentionally limited to what Milestone 2 requires: Physician,
// Patient, ProcedureType, Surgery, Control. No ResearchStudy, no Resident
// table — see the SurgeryParticipant model below for why participating
// resident ids are still persisted without one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Physician {
  id          String   @id
  firstName   String
  lastName    String
  phone       String
  email       String
  dateOfBirth DateTime
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patients                Patient[]
  procedureTypes          ProcedureType[]
  surgeries               Surgery[]
  residents               Resident[]
  credential              PhysicianCredential?
  sessions                Session[]
  emailConfirmationTokens EmailConfirmationToken[]
  researchStudies         ResearchStudy[]

  @@map("physicians")
}

// The login credential for a Physician — deliberately not part of the
// Physician model itself (see
// packages/application/src/physician/physician-credential-repository.ts):
// Physician (Domain) has no password concept. `emailNormalized` is the
// lowercased form of `email`, unique-constrained, so email uniqueness is
// enforced case-insensitively without requiring the `citext` Postgres
// extension (which would need CREATE EXTENSION privileges this milestone
// doesn't assume are available).
model PhysicianCredential {
  physicianId     String    @id
  email           String
  emailNormalized String    @unique
  passwordHash    String
  // Null until the physician clicks their emailed confirmation link
  // (ADR 0015) — `login` refuses an unconfirmed credential.
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  physician Physician @relation(fields: [physicianId], references: [id])

  @@map("physician_credentials")
}

// A single-use, expiring token proving a physician clicked the
// confirmation link emailed to the address they registered with (ADR
// 0015). Deliberately shaped like Session (opaque id, physicianId,
// expiresAt) — same kind of server-issued bearer token, different
// purpose, not a new pattern.
model EmailConfirmationToken {
  id          String   @id
  physicianId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  physician Physician @relation(fields: [physicianId], references: [id])

  @@index([physicianId])
  @@map("email_confirmation_tokens")
}

// Server-side session (PostgreSQL-backed, per the approved decision — no
// JWT, no Redis). `id` is the opaque token the browser holds via a
// cookie; it is never the physicianId.
//
// `userType`/`residentId` are ADR 0017's extension: a Resident now
// authenticates too. `physicianId` keeps its original meaning (the
// tenant) and is populated identically for both kinds of session — see
// packages/application/src/physician/session-repository.ts for the full
// reasoning behind this shape over a discriminated union or a parallel
// ResidentSession table.
model Session {
  id          String   @id
  userType    String   @default("physician")
  physicianId String
  residentId  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  physician Physician @relation(fields: [physicianId], references: [id])
  resident  Resident? @relation(fields: [residentId], references: [id])

  @@index([physicianId])
  @@index([residentId])
  @@map("sessions")
}

model Patient {
  id           String   @id
  physicianId  String
  firstName    String
  lastName     String
  phone        String
  email        String
  dateOfBirth  DateTime
  metadata     Json?
  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  physician Physician @relation(fields: [physicianId], references: [id])
  surgeries Surgery[]

  @@index([physicianId])
  @@map("patients")
}

model ProcedureType {
  id          String   @id
  physicianId String
  name        String
  description String?
  technique   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  physician    Physician               @relation(fields: [physicianId], references: [id])
  surgeries    Surgery[]
  customFields CustomFieldDefinition[]

  @@index([physicianId])
  @@map("procedure_types")
}

// CustomField definitions are an internal collection of the ProcedureType
// aggregate (ADR 0018) — a field's name must be unique within its owning
// ProcedureType, which could not be enforced correctly if definitions
// were loaded/saved independently of it. Written/read only through
// ProcedureTypeRepository, never through a repository of its own —
// mirrors Control's relationship to Surgery.
//
// `constraintMin`/`constraintMax` are stored as strings so the same pair
// of columns can carry either a NUMBER's numeric bounds or a DATE's date
// bounds (parsed/formatted by the mapper based on `valueType`) without a
// separate column pair per type.
model CustomFieldDefinition {
  id                  String  @id
  procedureTypeId     String
  name                String
  description         String?
  unit                String
  magnitude           String
  scope               String
  valueType           String
  constraintMin       String?
  constraintMax       String?
  constraintMaxLength Int?
  enumOptions         Json?

  procedureType ProcedureType      @relation(fields: [procedureTypeId], references: [id])
  values        CustomFieldValue[]

  @@index([procedureTypeId])
  @@map("custom_field_definitions")
}

// A recorded CustomField value, scoped to either a Surgery or a Control
// per its definition's `scope` — exactly one of `surgeryId`/`controlId`
// is set. Written/read only through ProcedureTypeRepository's sibling,
// SurgeryRepository (never its own repository), matching how Control
// values themselves are persisted (ADR 0019). Only one of the four
// `value*` columns is populated per row, selected by the referenced
// definition's `valueType`.
model CustomFieldValue {
  id              String    @id
  definitionId    String
  surgeryId       String?
  controlId       String?
  valueNumber     Float?
  valueText       String?
  valueDate       DateTime?
  valueEnumOption String?

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id])
  surgery    Surgery?              @relation(fields: [surgeryId], references: [id])
  control    Control?              @relation(fields: [controlId], references: [id])

  @@index([definitionId])
  @@index([surgeryId])
  @@index([controlId])
  @@map("custom_field_values")
}

// Mirrors Patient exactly (see Milestone 5). Resident is a plain Entity
// with no child state and no Resident<->Patient relationship (see
// resident.ts) — every field Resident.create() accepts is exactly what's
// stored.
model Resident {
  id          String   @id
  physicianId String
  firstName   String
  lastName    String
  phone       String
  email       String
  dateOfBirth DateTime
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  physician  Physician           @relation(fields: [physicianId], references: [id])
  credential ResidentCredential?
  sessions   Session[]

  @@index([physicianId])
  @@map("residents")
}

// The login credential for a Resident (ADR 0017) — deliberately not
// part of the Resident model itself, same reasoning as
// PhysicianCredential above. `physicianId` is denormalized here purely
// so this table's own queries can tenant-scope without a join; it is
// never the source of truth for tenancy (Resident.physicianId is).
//
// `temporaryPassword` is the one deliberate departure from
// PhysicianCredential's hash-only posture: it holds the CURRENT
// temporary password in cleartext, but only while `mustChangePassword`
// is still true — the Physician can read it back in `web` until the
// Resident changes it (ADR 0017, decision item 4). It is set to NULL
// the moment the Resident changes their password; `passwordHash` alone
// is authoritative for verifying a login from that point on.
model ResidentCredential {
  residentId         String   @id
  physicianId        String
  email              String
  emailNormalized    String   @unique
  passwordHash       String
  temporaryPassword  String?
  mustChangePassword Boolean  @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([physicianId])
  @@map("resident_credentials")
}

model Surgery {
  id              String   @id
  physicianId     String
  patientId       String
  procedureTypeId String
  performedAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  physician         Physician            @relation(fields: [physicianId], references: [id])
  patient           Patient              @relation(fields: [patientId], references: [id])
  procedureType     ProcedureType        @relation(fields: [procedureTypeId], references: [id])
  controls          Control[]
  participants      SurgeryParticipant[]
  customFieldValues CustomFieldValue[]

  @@index([physicianId])
  @@map("surgeries")
}

// Control is an internal entity of the Surgery aggregate (see
// docs/architecture/application-layer-discovery.md §1.3/§3) — this table
// is written/read only through SurgeryRepository, never through a
// repository of its own.
model Control {
  id                String   @id
  surgeryId         String
  observations      String
  recordedAt        DateTime
  authorType        String
  authorPhysicianId String?
  authorResidentId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  surgery           Surgery            @relation(fields: [surgeryId], references: [id])
  customFieldValues CustomFieldValue[]

  @@index([surgeryId])
  @@map("controls")
}

// Persists Surgery.participatingResidentIds — a Set<string> of opaque
// resident ids that Surgery itself never validates against a Resident
// record (see surgery.ts: assignResident only checks the acting
// physician). Deliberately has NO relation to a "residents" table:
// Resident persistence is out of scope for this milestone. This table
// stores exactly what the Surgery aggregate already owns, nothing more.
model SurgeryParticipant {
  surgeryId  String
  residentId String

  surgery Surgery @relation(fields: [surgeryId], references: [id])

  @@id([surgeryId, residentId])
  @@map("surgery_participants")
}

// ResearchStudy is its own aggregate (Milestone 6), referencing Surgeries
// only by id via the ResearchStudySurgery bridge table below — never
// embedding Surgery. Text fields are nullable because the domain
// attributes are optional; `status` mirrors ResearchStudyStatus exactly
// ("DRAFT" | "IN_PROGRESS" | "COMPLETED").
model ResearchStudy {
  id          String   @id
  physicianId String
  hypothesis  String?
  results     String?
  analysis    String?
  conclusion  String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  physician Physician              @relation(fields: [physicianId], references: [id])
  surgeries ResearchStudySurgery[]

  @@index([physicianId])
  @@map("research_studies")
}

// Persists ResearchStudy.surgeryIds — a Set<string> of Surgery ids the
// aggregate references but never embeds (see ResearchStudy above).
// Mirrors SurgeryParticipant's shape exactly: a plain bridge table with no
// independent entity or rules of its own.
model ResearchStudySurgery {
  researchStudyId String
  surgeryId       String

  researchStudy ResearchStudy @relation(fields: [researchStudyId], references: [id])

  @@id([researchStudyId, surgeryId])
  @@map("research_study_surgeries")
}
