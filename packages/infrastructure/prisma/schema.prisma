// Prisma schema. Started at Milestone 2 (core-loop persistence) and grown
// with each vertical slice: Resident + ResidentCredential (M5/M8.5),
// ResearchStudy + ResearchStudySurgery (M6), PhysicianCredential /
// Session / EmailConfirmationToken (M3/M8.5), CustomFieldDefinition /
// CustomFieldValue (M8.6, ADR 0018/0019/0020), Patient.dni (M8.7,
// ADR 0021). `technique` was dropped from ProcedureType at M8.8 (ADR
// 0022). Each model carries its own comment for the non-obvious choices.
//
// Written and read only through the repository implementations in
// `packages/infrastructure/src` — never touched by `packages/http` or
// `packages/web` directly (dependency direction: Infrastructure →
// Application/Domain only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Physician {
  id          String   @id
  firstName   String
  lastName    String
  phone       String
  email       String
  dateOfBirth DateTime
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patients                Patient[]
  procedureTypes          ProcedureType[]
  surgeries               Surgery[]
  residents               Resident[]
  credential              PhysicianCredential?
  sessions                Session[]
  emailConfirmationTokens EmailConfirmationToken[]
  researchStudies         ResearchStudy[]

  @@map("physicians")
}

// The login credential for a Physician — deliberately not part of the
// Physician model itself (see
// packages/application/src/physician/physician-credential-repository.ts):
// Physician (Domain) has no password concept. `emailNormalized` is the
// lowercased form of `email`, unique-constrained, so email uniqueness is
// enforced case-insensitively without requiring the `citext` Postgres
// extension (which would need CREATE EXTENSION privileges this milestone
// doesn't assume are available).
model PhysicianCredential {
  physicianId     String    @id
  email           String
  emailNormalized String    @unique
  passwordHash    String
  // Null until the physician clicks their emailed confirmation link
  // (ADR 0015) — `login` refuses an unconfirmed credential.
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  physician Physician @relation(fields: [physicianId], references: [id])

  @@map("physician_credentials")
}

// A single-use, expiring token proving a physician clicked the
// confirmation link emailed to the address they registered with (ADR
// 0015). Deliberately shaped like Session (opaque id, physicianId,
// expiresAt) — same kind of server-issued bearer token, different
// purpose, not a new pattern.
model EmailConfirmationToken {
  id          String   @id
  physicianId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  physician Physician @relation(fields: [physicianId], references: [id])

  @@index([physicianId])
  @@map("email_confirmation_tokens")
}

// Server-side session (PostgreSQL-backed, per the approved decision — no
// JWT, no Redis). `id` is the opaque token the browser holds via a
// cookie; it is never the physicianId.
//
// `userType`/`residentId` are ADR 0017's extension: a Resident now
// authenticates too. `physicianId` keeps its original meaning (the
// tenant) and is populated identically for both kinds of session — see
// packages/application/src/physician/session-repository.ts for the full
// reasoning behind this shape over a discriminated union or a parallel
// ResidentSession table.
model Session {
  id          String   @id
  userType    String   @default("physician")
  physicianId String
  residentId  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  physician Physician @relation(fields: [physicianId], references: [id])
  resident  Resident? @relation(fields: [residentId], references: [id])

  @@index([physicianId])
  @@index([residentId])
  @@map("sessions")
}

model Patient {
  id           String   @id
  physicianId  String
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  // National ID / identity document — optional (ADR 0021). Unique per
  // tenant when present: Postgres treats NULLs as distinct in a unique
  // index, so any number of dni-less patients coexist while two with the
  // same (physicianId, dni) are rejected.
  dni          String?
  metadata     Json?
  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  physician Physician @relation(fields: [physicianId], references: [id])
  surgeries Surgery[]

  @@unique([physicianId, dni])
  @@index([physicianId])
  @@map("patients")
}

model ProcedureType {
  id          String   @id
  physicianId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  physician          Physician               @relation(fields: [physicianId], references: [id])
  surgeries          Surgery[]
  customFields       CustomFieldDefinition[]
  controlDefinitions ControlDefinition[]

  @@index([physicianId])
  @@map("procedure_types")
}

// A control definition (ADR 0026) — typing + an occurrence rule — is an
// internal collection of the ProcedureType aggregate, mirroring
// CustomFieldDefinition: name unique within its owning ProcedureType,
// written/read only through ProcedureTypeRepository.
//
// The occurrence rule is flattened: `occurrenceMode` is "uncapped" |
// "capped"; the three `occurrence*` columns are populated only when
// capped (count + period every/unit). ADR 0027 freezes a definition once
// any Control references it — enforced in the Application layer, not here.
model ControlDefinition {
  id                    String   @id
  procedureTypeId       String
  name                  String
  occurrenceMode        String
  occurrenceCount       Int?
  occurrencePeriodEvery Int?
  occurrencePeriodUnit  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  procedureType ProcedureType @relation(fields: [procedureTypeId], references: [id])
  controls      Control[]

  @@index([procedureTypeId])
  @@map("control_definitions")
}

// CustomField definitions are an internal collection of the ProcedureType
// aggregate (ADR 0018) — a field's name must be unique within its owning
// ProcedureType, which could not be enforced correctly if definitions
// were loaded/saved independently of it. Written/read only through
// ProcedureTypeRepository, never through a repository of its own —
// mirrors Control's relationship to Surgery.
//
// `constraintMin`/`constraintMax` are stored as strings so the same pair
// of columns can carry either a NUMBER's numeric bounds or a DATE's date
// bounds (parsed/formatted by the mapper based on `valueType`) without a
// separate column pair per type.
//
// `unit` is nullable and only ever populated for a `NUMBER` field (ADR
// 0020, amending 0018): it is metadata of a numeric measurement, so the
// mapper reads/writes it as part of the NUMBER constraint. There is no
// `magnitude` column — a field's clinical dimension is its `name`.
model CustomFieldDefinition {
  id                  String  @id
  procedureTypeId     String
  name                String
  description         String?
  unit                String?
  scope               String
  valueType           String
  constraintMin       String?
  constraintMax       String?
  constraintMaxLength Int?
  enumOptions         Json?

  procedureType ProcedureType      @relation(fields: [procedureTypeId], references: [id])
  values        CustomFieldValue[]

  @@index([procedureTypeId])
  @@map("custom_field_definitions")
}

// A recorded CustomField value, scoped to either a Surgery or a Control
// per its definition's `scope` — exactly one of `surgeryId`/`controlId`
// is set. Written/read only through ProcedureTypeRepository's sibling,
// SurgeryRepository (never its own repository), matching how Control
// values themselves are persisted (ADR 0019). Only one of the four
// `value*` columns is populated per row, selected by the referenced
// definition's `valueType`.
model CustomFieldValue {
  id              String    @id
  definitionId    String
  surgeryId       String?
  controlId       String?
  valueNumber     Float?
  valueText       String?
  valueDate       DateTime?
  valueEnumOption String?

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id])
  surgery    Surgery?              @relation(fields: [surgeryId], references: [id])
  control    Control?              @relation(fields: [controlId], references: [id])

  @@index([definitionId])
  @@index([surgeryId])
  @@index([controlId])
  @@map("custom_field_values")
}

// Mirrors Patient exactly (see Milestone 5). Resident is a plain Entity
// with no child state and no Resident<->Patient relationship (see
// resident.ts) — every field Resident.create() accepts is exactly what's
// stored.
model Resident {
  id          String   @id
  physicianId String
  firstName   String
  lastName    String
  phone       String
  email       String
  dateOfBirth DateTime
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  physician  Physician           @relation(fields: [physicianId], references: [id])
  credential ResidentCredential?
  sessions   Session[]

  @@index([physicianId])
  @@map("residents")
}

// The login credential for a Resident. Deliberately not part of the
// Resident model itself, same reasoning as PhysicianCredential above.
// `physicianId` is denormalized here purely so this table's own queries
// can tenant-scope without a join; it is never the source of truth for
// tenancy (Resident.physicianId is).
//
// `passwordHash` is nullable — ADR 0029 (amending ADR 0017): a Resident
// has no usable credential until they accept an emailed invitation and
// set their own password. "Has this Resident accepted?" is exactly "is
// `passwordHash` set?" — no separate status field, see ADR 0029's
// "Technical representation". `invitedAt`/`acceptedAt` are display-only
// (Physician-facing invitation status), never used for access control.
model ResidentCredential {
  residentId  String    @id
  physicianId String
  email       String
  emailNormalized String @unique
  passwordHash String?
  invitedAt   DateTime  @default(now())
  acceptedAt  DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  resident          Resident                 @relation(fields: [residentId], references: [id])
  invitationTokens  ResidentInvitationToken[]

  @@index([physicianId])
  @@map("resident_credentials")
}

// A single-use, expiring token proving a Resident opened the invitation
// link emailed to them (ADR 0029). Shaped exactly like
// EmailConfirmationToken — same kind of opaque, server-issued bearer
// token, for a different principal/purpose, not a new pattern.
model ResidentInvitationToken {
  id         String   @id
  residentId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  resident ResidentCredential @relation(fields: [residentId], references: [residentId])

  @@index([residentId])
  @@map("resident_invitation_tokens")
}

model Surgery {
  id              String   @id
  physicianId     String
  patientId       String
  procedureTypeId String
  performedAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  physician         Physician            @relation(fields: [physicianId], references: [id])
  patient           Patient              @relation(fields: [patientId], references: [id])
  procedureType     ProcedureType        @relation(fields: [procedureTypeId], references: [id])
  controls          Control[]
  participants      SurgeryParticipant[]
  customFieldValues CustomFieldValue[]

  @@index([physicianId])
  @@map("surgeries")
}

// Control is an internal entity of the Surgery aggregate (see
// docs/architecture/application-layer-discovery.md §1.3/§3) — this table
// is written/read only through SurgeryRepository, never through a
// repository of its own.
model Control {
  id                String   @id
  surgeryId         String
  // Optional since Milestone 11 (A4/F-08): a Control may carry only a
  // datetime + author + CustomField values.
  observations      String?
  recordedAt        DateTime
  authorType        String
  authorPhysicianId String?
  authorResidentId  String?
  // The control definition (ADR 0026) this recording is an occurrence of,
  // or NULL for an ad-hoc control. Id-only column (nullable relation),
  // mirroring the SurgeryParticipant / research_study_surgeries id-only
  // precedent — the aggregate boundary is Surgery, and ControlDefinition
  // lives in the ProcedureType aggregate.
  definitionId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  surgery           Surgery            @relation(fields: [surgeryId], references: [id])
  definition        ControlDefinition? @relation(fields: [definitionId], references: [id])
  customFieldValues CustomFieldValue[]

  @@index([surgeryId])
  @@index([definitionId])
  @@map("controls")
}

// Persists Surgery.participatingResidentIds — a Set<string> of opaque
// resident ids that Surgery itself never validates against a Resident
// record (see surgery.ts: assignResident only checks the acting
// physician). Deliberately has NO relation to a "residents" table:
// Resident persistence is out of scope for this milestone. This table
// stores exactly what the Surgery aggregate already owns, nothing more.
model SurgeryParticipant {
  surgeryId  String
  residentId String

  surgery Surgery @relation(fields: [surgeryId], references: [id])

  @@id([surgeryId, residentId])
  @@map("surgery_participants")
}

// ResearchStudy is its own aggregate (Milestone 6), referencing Surgeries
// only by id via the ResearchStudySurgery bridge table below — never
// embedding Surgery. Text fields are nullable because the domain
// attributes are optional; `status` mirrors ResearchStudyStatus exactly
// ("DRAFT" | "IN_PROGRESS" | "COMPLETED").
model ResearchStudy {
  id          String   @id
  physicianId String
  hypothesis  String?
  results     String?
  analysis    String?
  conclusion  String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  physician Physician              @relation(fields: [physicianId], references: [id])
  surgeries ResearchStudySurgery[]

  @@index([physicianId])
  @@map("research_studies")
}

// Persists ResearchStudy.surgeryIds — a Set<string> of Surgery ids the
// aggregate references but never embeds (see ResearchStudy above).
// Mirrors SurgeryParticipant's shape exactly: a plain bridge table with no
// independent entity or rules of its own.
model ResearchStudySurgery {
  researchStudyId String
  surgeryId       String

  researchStudy ResearchStudy @relation(fields: [researchStudyId], references: [id])

  @@id([researchStudyId, surgeryId])
  @@map("research_study_surgeries")
}
