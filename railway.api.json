{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @cirugias-cruz/infrastructure run prisma:generate",
    "watchPatterns": [
      "packages/http/**",
      "packages/infrastructure/**",
      "packages/application/**",
      "packages/domain/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      "railway.api.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @cirugias-cruz/http run start",
    "preDeployCommand": ["pnpm --filter @cirugias-cruz/infrastructure exec prisma migrate deploy"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
