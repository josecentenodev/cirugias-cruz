# The database the running app uses (dev: your own local/dev database —
# never paste the production URL here).
DATABASE_URL="postgresql://user:password@host:5432/database"

# The ONLY database the DB-backed test suites touch (scripts/test-database.mjs).
# Must be local unless TEST_DATABASE_ALLOW_REMOTE=1; never equal to DATABASE_URL.
# Setup: docs/architecture/deployment-railway.md § Test database.
DATABASE_URL_TEST="postgresql://cirugias_test:password@localhost:5432/cirugias_test"
