{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @cirugias-cruz/web run build",
    "watchPatterns": [
      "packages/web/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      "railway.web.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @cirugias-cruz/web run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
